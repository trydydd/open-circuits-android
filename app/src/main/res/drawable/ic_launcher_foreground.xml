<?xml version="1.0" encoding="utf-8"?>
<!--
  Open Circuits logo: copper ring + centre dot on transparent background.
  Derived from docs/logo.svg — see res/icons/README for regen commands.
  Viewport 108x108 (standard adaptive icon canvas).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Copper ring (stroke-only circle, centre-line at radius 40) -->
    <path
        android:pathData="M14,54 A40,40 0 0,1 94,54 A40,40 0 0,1 14,54 Z"
        android:fillColor="#00000000"
        android:strokeColor="#935F16"
        android:strokeWidth="12" />

    <!-- Copper centre dot -->
    <path
        android:pathData="M43,54 A11,11 0 0,1 65,54 A11,11 0 0,1 43,54 Z"
        android:fillColor="#935F16" />

</vector>
